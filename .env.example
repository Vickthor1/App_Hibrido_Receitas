# Supabase — https://supabase.com/dashboard (free, sem cartão)
# Copie para .env e preencha. Suporta EXPO_PUBLIC_ (Expo) e VITE_ (Vite)
EXPO_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...ou eyJ...anon...
# Alternativa Vite (mantida por compatibilidade):
# VITE_SUPABASE_URL=https://seu-projeto.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Senha do DB (apenas para conexão direta Postgres, NÃO expor no client)
# Mantenha em segredo, use apenas localmente se precisar de psql
# SUPABASE_DB_PASSWORD=***
